{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "denialops",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/mcp", "/connect/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "denialops",
      // Replace with the id printed by: npx wrangler d1 create denialops
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "denialops-files" }
  ],
  "observability": { "enabled": true }
}
